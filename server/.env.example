# Server
PORT=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Brevo SMTP (used by utils/sendEmail.js and the absent-reminder cron)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-brevo-smtp-login
SMTP_KEY=your-brevo-smtp-key

# Brevo transactional API (used by utils/brevoClient.js)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=noreply@example.com

# Shared secret required in the "x-api-key" header for all /api/email/* requests.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_API_KEY=replace-with-a-long-random-secret

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8081
