# WeaponFitness API — local environment template.
# Copy to backend/.env and fill in. NEVER commit the real .env.

# Postgres connection string (Supabase → Project Settings → Database).
# Required — the app refuses to boot without it.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project URL — used to fetch the JWKS for JWT verification.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy HS256 JWT secret (only if your project still issues HS256 tokens):
# Supabase dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Local-dev only: skip JWT verification and act as Owner. NEVER in production.
AUTH_DISABLED=false

ENV=development

# HMAC secret for the rotating check-in QR — generate with: python -c "import secrets; print(secrets.token_hex(32))"
CHECKIN_SECRET=
