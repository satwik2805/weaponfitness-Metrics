# ===============================
# Secrets — env files anywhere in the tree.
# server/.env was once committed with live keys; never again.
# ===============================
.env
.env.*
!.env.example
**/.env
!**/.env.example

# ===============================
# React Native / Expo
# ===============================
node_modules/
.expo/
.expo-shared/
web-build/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Metro / Cache
.cache/
.metro-cache/

# Android & iOS native directories (generated dynamically during prebuild)
android/
ios/
*.keystore

# ===============================
# Python / FastAPI Backend
# ===============================
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
*.db

# Uvicorn / logs
uvicorn*.log
*.log

# Environment variables — consolidated at the top of this file
!.env.example
!**/.env.example

# ===============================
# System files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# IDE
# ===============================
.vscode/
.idea/

# ===============================
# Expo & temporary files
# ===============================
.expo/web/
.expo/cache/
.expo/types/

# Debug scripts
backend/debug_*.py
backend/*.log

# Database migrations cache
alembic/versions/__pycache__/

# Supabase CLI temp
supabase/.temp/

# local demo credential scratch files
*.tmp
