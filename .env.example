# Weapon Fitness app — local environment template.
# Copy to .env and fill in. NEVER commit the real .env.

# Supabase project (client-safe values only — anon key, never service role)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# FastAPI backend base URL for the mobile app (EXPO_PUBLIC_ vars are inlined
# into the client bundle at build time — public by definition).
EXPO_PUBLIC_API_URL=http://localhost:8000/
